# Cloudflare Pages redirects. Short English paths for the legal pages
# (the pages themselves are built by legal/build.mjs).
/privacy  /en/privacy  301
/imprint  /en/imprint  301
/terms    /en/terms    301
# The Global tool's live page for TVs (openvolley backend lib/tvPage.js):
# a short address to type with a TV remote. 302, not 301: a TV must not
# remember it if the page ever moves.
/tv        https://backend.openvolley.app/tv/        302
/tv/       https://backend.openvolley.app/tv/        302
/tv/:code  https://backend.openvolley.app/tv/:code  302
/tv/:code/:court  https://backend.openvolley.app/tv/:code/:court  302
# The guides' folder has no page of its own: its address goes to the list
# of guides on the support page.
/support/guides   /support#guides  302
/support/guides/  /support#guides  302
/guides           /support#guides  302
/guides/          /support#guides  302
